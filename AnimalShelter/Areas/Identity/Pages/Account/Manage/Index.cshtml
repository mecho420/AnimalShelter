@page
@model IndexModel
@{
    ViewData["Title"] = "Профил";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="manage-panel">
    <h2 class="manage-card-title">Профил</h2>
    <p class="manage-card-subtitle">
        Прегледай и редактирай основната информация за своя акаунт.
    </p>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="profile-form" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-warning"></div>

        <div class="mb-3">
            <label class="form-label">Потребителско име</label>
            <input asp-for="Username" class="form-control" disabled />
        </div>

        <div class="mb-3">
            <label asp-for="Input.PhoneNumber" class="form-label">Телефонен номер</label>
            <input asp-for="Input.PhoneNumber" class="form-control" />
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>

        <div class="manage-actions">
            <button id="update-profile-button" type="submit" class="btn btn-primary">Запази промените</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}