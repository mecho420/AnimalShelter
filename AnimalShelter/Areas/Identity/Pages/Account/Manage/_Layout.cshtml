@{
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="manage-page">
    <div class="container">
        <div class="manage-header">
            <h1 class="manage-title">Управление на профила</h1>
            <p class="manage-subtitle">
                Тук можеш да редактираш своя профил, имейл, парола и настройки за сигурност.
            </p>
        </div>

        <div class="manage-wrapper">
            <div class="row g-0">
                <div class="col-lg-3">
                    <div class="manage-sidebar">
                        <partial name="_ManageNav" />
                    </div>
                </div>

                <div class="col-lg-9">
                    <div class="manage-content">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}