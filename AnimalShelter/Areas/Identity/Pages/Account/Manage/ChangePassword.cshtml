@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Парола";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="manage-panel">
    <h2 class="manage-card-title">Смяна на парола</h2>
    <p class="manage-card-subtitle">
        Актуализирай своята парола, за да поддържаш профила си защитен.
    </p>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="manage-note">
        Използвай силна парола, която съдържа комбинация от букви, цифри и символи.
    </div>

    <form id="change-password-form" method="post">

        <div class="mb-3">
            <label asp-for="Input.OldPassword" class="form-label">Текуща парола</label>
            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.NewPassword" class="form-label">Нова парола</label>
            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.ConfirmPassword" class="form-label">Потвърди новата парола</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="manage-actions">
            <button type="submit" class="btn btn-primary">Запази новата парола</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}