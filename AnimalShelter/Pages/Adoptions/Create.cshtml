@page
@model AnimalShelter.Pages.Adoptions.CreateModel

@{
    ViewData["Title"] = "Заявка за осиновяване";
    var a = Model.Animal;
    var img = string.IsNullOrWhiteSpace(a?.ImagePath) ? "/images/animals/default-dog.jpg" : a.ImagePath;
}

<div class="mb-4 text-center">
    <h1 class="adoption-heading">Заявка за осиновяване</h1>
    <p class="adoption-subtext">
        Попълни своите данни и направи първата стъпка към това да дадеш дом на едно спасено животно.
    </p>
</div>

<div class="row g-4 align-items-start">

    <div class="col-12 col-lg-5">
        <div class="adoption-animal-box h-100">
            <h4 class="fw-bold mb-3">Животно</h4>

            <img src="@img" class="adoption-preview-img mb-4" alt="Снимка на @a?.Name" />

            <h4 class="fw-bold mb-3">@a?.Name</h4>

            <div class="adoption-info-line"><strong>Вид:</strong> @a?.Species</div>
            <div class="adoption-info-line"><strong>Възраст:</strong> @a?.Age години</div>

            <div class="mt-4">
                <a class="btn btn-outline-secondary w-100"
                   asp-page="/Animals/Details"
                   asp-route-id="@a?.Id">
                    Назад към детайли
                </a>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="adoption-form-box">
            <h4 class="fw-bold mb-3">Вашите данни</h4>

            <div class="adoption-helper mb-4">
                Колкото по-подробно попълниш информацията, толкова по-лесно приютът ще прецени дали животното е подходящо за теб.
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-warning"></div>

            <form method="post">
                <div class="row g-3">

                    <div class="col-12">
                        <label asp-for="Input.FullName" class="form-label"></label>
                        <input asp-for="Input.FullName" class="form-control" placeholder="Например: Иван Иванов" />
                        <span asp-validation-for="Input.FullName" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Input.Phone" class="form-label"></label>
                        <input asp-for="Input.Phone" class="form-control" placeholder="08xxxxxxxx" />
                        <span asp-validation-for="Input.Phone" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" placeholder="example@mail.com" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.Comment" class="form-label"></label>
                        <textarea asp-for="Input.Comment"
                                  class="form-control"
                                  rows="6"
                                  placeholder="Опиши защо искаш да осиновиш това животно, дали имаш опит с домашни любимци, какви условия можеш да му осигуриш и защо смяташ, че ще бъдеш добър стопанин."></textarea>
                        <span asp-validation-for="Input.Comment" class="text-danger"></span>
                    </div>

                </div>

                <div class="mt-4 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-success">Подай заявката</button>
                    <a class="btn btn-outline-secondary" asp-page="/Animals/Index">Към всички животни</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
