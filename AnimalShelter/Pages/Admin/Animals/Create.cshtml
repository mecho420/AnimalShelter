@page
@model AnimalShelter.Pages.Admin.Animals.CreateModel

@{
    ViewData["Title"] = "Добави животно";
}

<div class="mb-4 text-center">
    <h1 class="admin-form-title">Добавяне на животно</h1>
    <p class="admin-form-subtitle">
        Въведи информация за ново животно и го публикувай в системата за осиновяване.
    </p>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-4">
        <div class="admin-form-section h-100">
            <div class="admin-form-box-title">
                <span class="admin-form-icon">📷</span>
                <span>Снимка и насоки</span>
            </div>

            <img src="/images/animals/default-dog.jpg" class="admin-preview-img mb-4" alt="Примерна снимка" />

            <div class="admin-form-helper">
                Качи ясна снимка на животното. Ако не добавиш снимка, системата ще използва стандартна примерна снимка.
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="admin-form-section">
            <div class="admin-form-box-title">
                <span class="admin-form-icon">🐾</span>
                <span>Основна информация</span>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-warning"></div>

            <form method="post" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.Name" class="form-label"></label>
                        <input asp-for="Input.Name" class="form-control" placeholder="Име на животното" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.Species" class="form-label"></label>
                        <input asp-for="Input.Species" class="form-control" placeholder="Куче, Котка..." />
                        <span asp-validation-for="Input.Species" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Input.Age" class="form-label"></label>
                        <input asp-for="Input.Age" class="form-control" />
                        <span asp-validation-for="Input.Age" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Input.Gender" class="form-label"></label>
                        <select asp-for="Input.Gender" class="form-select"
                                asp-items="Html.GetEnumSelectList<AnimalShelter.Models.Enums.Gender>()"></select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Input.Status" class="form-label"></label>
                        <select asp-for="Input.Status" class="form-select"
                                asp-items="Html.GetEnumSelectList<AnimalShelter.Models.Enums.AnimalStatus>()"></select>
                    </div>

                    <div class="col-12">
                        <label asp-for="ImageFile" class="form-label">Снимка</label>
                        <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text">Позволени формати: JPG, JPEG, PNG, WEBP</div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="4"
                                  placeholder="Опиши характера, навиците и особеностите на животното."></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.HealthInfo" class="form-label"></label>
                        <textarea asp-for="Input.HealthInfo" class="form-control" rows="3"
                                  placeholder="Например: ваксинирано, обезпаразитено, кастрирано..."></textarea>
                        <span asp-validation-for="Input.HealthInfo" class="text-danger"></span>
                    </div>
                </div>

                <div class="admin-form-actions">
                    <button type="submit" class="btn btn-success">Запази</button>
                    <a asp-page="/Admin/Animals/Index" class="btn btn-outline-secondary">Назад</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}