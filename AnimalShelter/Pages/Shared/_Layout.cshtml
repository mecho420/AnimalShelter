<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AnimalShelter</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AnimalShelter.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light sticky-top mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <span class="brand-paw">🐾</span>
                    <span>AnimalShelter</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")"
                               asp-page="/Index">
                                Начало
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Animals") == true ? "active" : "")"
                               asp-page="/Animals/Index">
                                Животни
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Adoptions/My") == true ? "active" : "")"
                                   asp-page="/Adoptions/My">
                                    Моите заявки
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Requests" ? "active" : "")"
                                   asp-page="/Admin/Requests">
                                    Заявки
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Admin/Animals") == true ? "active" : "")"
                                   asp-page="/Admin/Animals/Index">
                                    Животни Admin
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Privacy" ? "active" : "")"
                               asp-page="/Privacy">
                                Privacy
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-lg-center">
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer mt-5">
        <div class="container py-5">
            <div class="row g-4">

                <div class="col-md-4">
                    <h4 class="footer-brand">AnimalShelter</h4>
                    <p class="footer-text">
                        Сайт, посветен на спасяването на животни и намирането на сигурен, обичащ дом за всяко от тях.
                    </p>
                </div>

                <div class="col-md-4">
                    <h5 class="footer-title">Навигация</h5>
                    <ul class="footer-links">
                        <li><a asp-page="/Index">Начало</a></li>
                        <li><a asp-page="/Animals/Index">Животни</a></li>
                        <li><a asp-page="/Adoptions/My">Моите заявки</a></li>
                        <li><a asp-page="/Privacy">Privacy</a></li>
                    </ul>
                </div>

                <div class="col-md-4">
                    <h5 class="footer-title">Мисия</h5>
                    <p class="footer-text">
                        Вярваме, че всяко животно заслужава шанс за нов живот, грижа и дом, изпълнен с любов.
                    </p>
                </div>

            </div>

            <hr class="footer-divider" />

            <div class="text-center footer-bottom">
                &copy; 2026 - AnimalShelter - Всеки живот заслужава дом
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>