@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))

{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle nav-profile-link d-flex align-items-center gap-1"
           href="#"
           id="profileDropdown"
           role="button"
           data-bs-toggle="dropdown"
           aria-expanded="false">
            @if (User.IsInRole("Admin"))

            {
                <span>🛠️ Админ профил</span>
            }

            else

            {
                <span>👤 Моят профил</span>
            }
        </a>

        <ul class="dropdown-menu dropdown-menu-end profile-dropdown" aria-labelledby="profileDropdown">
            <li>
                <a class="dropdown-item"
                   asp-area="Identity"
                   asp-page="/Account/Manage/Index">
                    Профил
                </a>
            </li>

            @if (!User.IsInRole("Admin"))

            {
                <li>
                    <a class="dropdown-item"
                       asp-page="/Adoptions/My">
                        Моите заявки
                    </a>
                </li>
            }

            @if (User.IsInRole("Admin"))

            {
                <li><hr class="dropdown-divider" /></li>

                <li>
                    <a class="dropdown-item"
                       asp-page="/Admin/Requests">
                        Админ заявки
                    </a>
                </li>

                <li>
                    <a class="dropdown-item"
                       asp-page="/Admin/Animals/Index">
                        Животни Admin
                    </a>
                </li>
            }

            <li><hr class="dropdown-divider" /></li>

            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="m-0">
                    <button type="submit" class="dropdown-item text-danger">
                        Изход
                    </button>
                </form>
            </li>
        </ul>
    </li>
}

else

{
    <li class="nav-item">
        <a class="nav-link text-dark"
           asp-area="Identity"
           asp-page="/Account/Register">
            Регистрация
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link text-dark"
           asp-area="Identity"
           asp-page="/Account/Login">
            Вход
        </a>
    </li>
}