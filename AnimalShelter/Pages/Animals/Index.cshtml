@page
@model AnimalShelter.Pages.Animals.IndexModel
@using AnimalShelter.Models.Enums
@using AnimalShelter.Helpers

@{
	ViewData["Title"] = "Животни за осиновяване";
}

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-warning"></div>
}

<div class="mb-4 text-center">
    <h1 class="fw-bold">Животни за осиновяване</h1>
    <p class="text-muted fs-5">
        Разгледай животните, филтрирай резултатите и намери приятел, който чака своя нов дом.
    </p>
</div>

<form method="get" class="filters-panel p-4 mb-5">
    <div class="row g-3 align-items-end">

        <div class="col-md-3">
            <label class="form-label">Търсене по име</label>
            <input type="text"
                   name="SearchTerm"
                   value="@Model.SearchTerm"
                   class="form-control"
                   placeholder="Например: Боби" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Вид</label>
            <input type="text"
                   name="Species"
                   value="@Model.Species"
                   class="form-control"
                   placeholder="Куче, Котка..." />
        </div>

        <div class="col-md-2">
            <label class="form-label">От възраст</label>
            <input type="number"
                   name="MinAge"
                   value="@Model.MinAge"
                   class="form-control"
                   min="0"
                   placeholder="0" />
        </div>

        <div class="col-md-2">
            <label class="form-label">До възраст</label>
            <input type="number"
                   name="MaxAge"
                   value="@Model.MaxAge"
                   class="form-control"
                   min="0"
                   placeholder="10" />
        </div>

        <div class="col-md-1">
            <label class="form-label">Пол</label>
            <select name="Gender" class="form-select">
                <option value="">Всички</option>
                <option value="Male" selected="@(Model.Gender == Gender.Male)">Мъжки</option>
                <option value="Female" selected="@(Model.Gender == Gender.Female)">Женски</option>
                <option value="Unknown" selected="@(Model.Gender == Gender.Unknown)">Неизвестен</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Статус</label>
            <select name="Status" class="form-select">
                <option value="">Всички</option>
                <option value="ForAdoption" selected="@(Model.Status == AnimalStatus.ForAdoption)">За осиновяване</option>
                <option value="Adopted" selected="@(Model.Status == AnimalStatus.Adopted)">Осиновено</option>
            </select>
        </div>

        <div class="col-12 d-flex gap-2 pt-2">
            <button type="submit" class="btn btn-primary">Филтрирай</button>
            <a asp-page="/Animals/Index" class="btn btn-outline-secondary">Изчисти</a>
        </div>
    </div>
</form>

<div class="row">
    @if (Model.Result == null || !Model.Result.Items.Any())
    {
        <div class="alert alert-info">
            Няма налични животни според избраните филтри.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var a in Model.Result.Items)
            {
                var img = string.IsNullOrWhiteSpace(a.ImagePath) ? "/images/animals/default-dog.jpg" : a.ImagePath;

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 animal-card @(a.Status == AnimalStatus.Adopted ? "opacity-75" : "")">
                        <img src="@img" class="card-img-top animal-img" alt="Снимка на @a.Name" />

                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@a.Name</h5>

                                @if (a.Status == AnimalStatus.ForAdoption)
                                {
                                    <span class="custom-badge badge-adoption">За осиновяване</span>
                                }
                                else
                                {
                                    <span class="custom-badge badge-adopted">Осиновено</span>
                                }
                            </div>

                            <div class="animal-meta mb-3">
                                <div><strong>Вид:</strong> @a.Species</div>
                                <div><strong>Възраст:</strong> @a.Age години</div>
                                <div><strong>Пол:</strong> @a.Gender.GetDisplayName()</div>
                            </div>

                            @if (a.Status == AnimalStatus.Adopted)
                            {
                                <small class="text-muted mb-3">
                                    Това животно вече е осиновено.
                                </small>
                            }

                            <div class="mt-auto">
                                <a class="btn btn-primary w-100"
                                   asp-page="/Animals/Details"
                                   asp-route-id="@a.Id">
                                    Виж детайли
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

    @if (Model.Result.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">

                <li class="page-item @(Model.Result.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-page="/Animals/Index"
                       asp-route-PageNumber="@(Model.PageNumber - 1)"
                       asp-route-Species="@Model.Species"
                       asp-route-Gender="@Model.Gender"
                       asp-route-Status="@Model.Status"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-MinAge="@Model.MinAge"
                       asp-route-MaxAge="@Model.MaxAge">
                        Предишна
                    </a>
                </li>

                @for (int i = 1; i <= Model.Result.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Result.PageNumber ? "active" : "")">
                        <a class="page-link"
                           asp-page="/Animals/Index"
                           asp-route-PageNumber="@i"
                           asp-route-Species="@Model.Species"
                           asp-route-Gender="@Model.Gender"
                           asp-route-Status="@Model.Status"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-MinAge="@Model.MinAge"
                           asp-route-MaxAge="@Model.MaxAge">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.Result.HasNextPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-page="/Animals/Index"
                       asp-route-PageNumber="@(Model.PageNumber + 1)"
                       asp-route-Species="@Model.Species"
                       asp-route-Gender="@Model.Gender"
                       asp-route-Status="@Model.Status"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-MinAge="@Model.MinAge"
                       asp-route-MaxAge="@Model.MaxAge">
                        Следваща
                    </a>
                </li>

            </ul>
        </nav>
    }

