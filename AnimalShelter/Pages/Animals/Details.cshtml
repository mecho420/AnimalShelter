@page "{id:int}"
@model AnimalShelter.Pages.Animals.DetailsModel
@using AnimalShelter.Helpers
@using AnimalShelter.Models.Enums

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">
        @TempData["Error"]
    </div>
}


@{
    ViewData["Title"] = "Детайли за животно";
    var a = Model.Animal;
    var img = string.IsNullOrWhiteSpace(a.ImagePath) ? "/images/animals/default-dog.jpg" : a.ImagePath;

    // badge клас за статус
    var statusBadge = a.Status.ToString() switch
    {
        "ForAdoption" => "bg-success", 
        "Adopted" => "bg-secondary",
        _ => "bg-secondary"
    };

    // badge клас за пол
    var genderBadge = a.Gender.ToString() switch
    {
        "Male" => "bg-primary",
        "Female" => "bg-danger",
        _ => "bg-secondary"
    };
}


<div class="mb-4 text-center">
    <h1 class="fw-bold">Детайли за животно</h1>
    <p class="text-muted fs-5">
        Научи повече за животното и прецени дали това е твоят бъдещ приятел.
    </p>
</div>

<div class="card details-card">
    <div class="row g-0">

        <div class="col-lg-5">
            <img src="@img" class="details-img" alt="Снимка на @a.Name" />
        </div>

        <div class="col-lg-7">
            <div class="details-content">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                    <div>
                        <h2 class="details-title mb-2">@a.Name</h2>

                        <div class="d-flex flex-wrap gap-2">
                            <span class="custom-badge @(a.Status == AnimalStatus.ForAdoption ? "badge-adoption" : "badge-adopted")">
                                Статус: @a.Status.GetDisplayName()
                            </span>

                            <span class="custom-badge badge-adopted">
                                Пол: @a.Gender.GetDisplayName()
                            </span>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="details-box">
                            <div class="details-box-label">Вид</div>
                            <div class="details-box-value">@a.Species</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="details-box">
                            <div class="details-box-label">Възраст</div>
                            <div class="details-box-value">@a.Age години</div>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h5 class="details-section-title">Описание</h5>
                    <p class="details-text mb-0">
                        @a.Description
                    </p>
                </div>

                <div class="mb-4">
                    <h5 class="details-section-title">Здравна информация</h5>
                    <p class="details-text mb-0">
                        @(!string.IsNullOrWhiteSpace(a.HealthInfo) ? a.HealthInfo : "Няма добавена информация.")
                    </p>
                </div>

                <div class="details-actions">
                    <a class="btn btn-outline-secondary" asp-page="/Animals/Index">Назад към животните</a>

                    @if (Model.Animal.Status == AnimalStatus.ForAdoption)
                    {
                        @if (!User.IsInRole("Admin"))
                        {
                            <a class="btn btn-success"
                               asp-page="/Adoptions/Create"
                               asp-route-animalId="@Model.Animal.Id">
                                Подай заявка за осиновяване
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-outline-secondary" disabled>
                                Admin не може да подава заявки
                            </button>
                        }
                    }
                    else
                    {
                        <button class="btn btn-secondary" disabled>Вече е осиновено</button>
                    }
                </div>

                @if (Model.Animal.Status != AnimalStatus.ForAdoption)
                {
                    <div class="details-note">
                        Това животно вече е осиновено и не приема нови заявки.
                    </div>
                }
            </div>
        </div>

    </div>
</div>
